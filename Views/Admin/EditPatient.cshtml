@model ClinicManagement.Models.ViewModels.CreatePatientViewModel
@{
    ViewData["Title"] = "Chỉnh sửa bệnh nhân";
    var patientId = ViewBag.PatientId;
    var patientName = ViewBag.PatientName;
}

<div class="page-header">
    <h2>
        <div class="icon" style="background:#fef3c7;color:#92400e"><i class="fas fa-user-edit"></i></div>
        Chỉnh sửa: @patientName
    </h2>
    <a asp-action="Patients" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i>Quay lại
    </a>
</div>

<div class="card">
    <div class="card-header">
        <i class="fas fa-edit text-warning me-2"></i>Cập nhật thông tin bệnh nhân
    </div>
    <div class="card-body p-4">
        <form asp-action="EditPatient" asp-route-id="@patientId" method="post">
            <div asp-validation-summary="All" class="alert alert-danger mb-3" style="display:@(ViewData.ModelState.ErrorCount > 0 ? "flex" : "none")"></div>

            <div class="row g-3">
                <div class="col-12">
                    <div class="fw-600 text-warning mb-2"><i class="fas fa-lock me-2"></i>Thông tin đăng nhập</div>
                    <div class="divider mt-0"></div>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Tên đăng nhập</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-user"></i></span>
                        <input value="@Model.Username" class="form-control" readonly style="background:#f8fafc;" />
                    </div>
                    <small class="text-muted">Tên đăng nhập không thể thay đổi</small>
                </div>
                <div class="col-md-6">
                    <label asp-for="Password" class="form-label">Mật khẩu mới</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-lock"></i></span>
                        <input asp-for="Password" class="form-control" type="password" placeholder="Để trống nếu không đổi mật khẩu" />
                    </div>
                    <small class="text-muted">Để trống nếu không muốn đổi mật khẩu</small>
                </div>

                <div class="col-12 mt-2">
                    <div class="fw-600 text-warning mb-2"><i class="fas fa-user-circle me-2"></i>Thông tin cá nhân</div>
                    <div class="divider mt-0"></div>
                </div>
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label">Họ và tên *</label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="DateOfBirth" class="form-label">Ngày sinh *</label>
                    <input asp-for="DateOfBirth" class="form-control" type="date" />
                    <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Gender" class="form-label">Giới tính *</label>
                    <select asp-for="Gender" class="form-select">
                        <option value="Nam">Nam</option>
                        <option value="Nữ">Nữ</option>
                    </select>
                    <span asp-validation-for="Gender" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label">Số điện thoại *</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-phone"></i></span>
                        <input asp-for="PhoneNumber" class="form-control" />
                    </div>
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label">Email *</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                        <input asp-for="Email" class="form-control" type="email" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="col-12 mt-2">
                    <div class="fw-600 text-warning mb-2"><i class="fas fa-info-circle me-2"></i>Thông tin bổ sung</div>
                    <div class="divider mt-0"></div>
                </div>
                <div class="col-md-8">
                    <label asp-for="Address" class="form-label">Địa chỉ</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-map-marker-alt"></i></span>
                        <input asp-for="Address" class="form-control" />
                    </div>
                </div>
                <div class="col-md-4">
                    <label asp-for="EmergencyContact" class="form-label">Liên hệ khẩn cấp</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-phone-square"></i></span>
                        <input asp-for="EmergencyContact" class="form-control" />
                    </div>
                </div>
                <div class="col-12">
                    <label asp-for="MedicalHistory" class="form-label">Tiền sử bệnh</label>
                    <textarea asp-for="MedicalHistory" class="form-control" rows="3"></textarea>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-warning text-white">
                    <i class="fas fa-save me-1"></i>Lưu thay đổi
                </button>
                <a asp-action="PatientDetail" asp-route-id="@patientId" class="btn btn-outline-info btn-sm">
                    <i class="fas fa-eye me-1"></i>Xem chi tiết
                </a>
                <a asp-action="Patients" class="btn btn-outline-secondary">
                    <i class="fas fa-times me-1"></i>Hủy
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@{ViewData["Title"] = "Dashboard - Quản trị";}
<div class="page-header">
    <h2><div class="icon" style="background:#dbeafe;color:#2563eb"><i class="fas fa-tachometer-alt"></i></div>Dashboard Quản trị</h2>
    <small class="text-muted"><i class="fas fa-clock me-1"></i>@DateTime.Now.ToString("dddd, dd/MM/yyyy")</small>
</div>
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3"><div class="stat-card blue"><div class="stat-icon"><i class="fas fa-user-md"></i></div><div class="stat-number">@ViewBag.TotalDoctors</div><div class="stat-label">Bác sĩ</div><div class="stat-bg"><i class="fas fa-user-md"></i></div></div></div>
    <div class="col-sm-6 col-xl-3"><div class="stat-card green"><div class="stat-icon"><i class="fas fa-users"></i></div><div class="stat-number">@ViewBag.TotalPatients</div><div class="stat-label">Bệnh nhân</div><div class="stat-bg"><i class="fas fa-users"></i></div></div></div>
    <div class="col-sm-6 col-xl-3"><div class="stat-card cyan"><div class="stat-icon"><i class="fas fa-calendar-alt"></i></div><div class="stat-number">@ViewBag.TotalAppointments</div><div class="stat-label">Tổng lịch hẹn</div><div class="stat-bg"><i class="fas fa-calendar-alt"></i></div></div></div>
    <div class="col-sm-6 col-xl-3"><div class="stat-card amber"><div class="stat-icon"><i class="fas fa-calendar-day"></i></div><div class="stat-number">@ViewBag.TodayAppointments</div><div class="stat-label">Lịch hẹn hôm nay</div><div class="stat-bg"><i class="fas fa-calendar-day"></i></div></div></div>
</div>
<div class="row g-3 mb-4">
    <div class="col-sm-6"><a asp-action="TodayAppointments" class="text-decoration-none"><div class="stat-card purple"><div class="stat-icon"><i class="fas fa-hourglass-half"></i></div><div class="stat-number">@ViewBag.TodayWaiting</div><div class="stat-label">Chờ khám hôm nay — Nhấn để xem</div><div class="stat-bg"><i class="fas fa-hourglass-half"></i></div></div></a></div>
    <div class="col-sm-6"><a asp-action="TodayAppointments" class="text-decoration-none"><div class="stat-card rose"><div class="stat-icon"><i class="fas fa-check-circle"></i></div><div class="stat-number">@ViewBag.TodayDone</div><div class="stat-label">Đã khám hôm nay — Nhấn để xem</div><div class="stat-bg"><i class="fas fa-check-circle"></i></div></div></a></div>
</div>
<div class="card glass-card border-0 shadow-sm">
    <div class="card-header"><i class="fas fa-bolt text-warning me-2"></i>Quản lý nhanh</div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4 col-sm-6"><a asp-action="Doctors" class="quick-action glass-card shadow-sm border-0"><div class="qa-icon" style="background:rgba(37,99,235,0.08);color:#2563eb"><i class="fas fa-user-md"></i></div><div><div class="fw-600">Quản lý Bác sĩ</div><small class="text-muted">Thêm, sửa, xóa bác sĩ</small></div></a></div>
            <div class="col-md-4 col-sm-6"><a asp-action="Patients" class="quick-action glass-card shadow-sm border-0"><div class="qa-icon" style="background:rgba(16,185,129,0.08);color:#10b981"><i class="fas fa-users"></i></div><div><div class="fw-600">Quản lý Bệnh nhân</div><small class="text-muted">CRUD đầy đủ</small></div></a></div>
            <div class="col-md-4 col-sm-6"><a asp-action="Specialties" class="quick-action glass-card shadow-sm border-0"><div class="qa-icon" style="background:hsla(var(--warning-hsl),0.08);color:var(--warning)"><i class="fas fa-stethoscope"></i></div><div><div class="fw-600">Chuyên khoa</div><small class="text-muted">Quản lý chuyên khoa</small></div></a></div>
            <div class="col-md-4 col-sm-6"><a asp-action="TodayAppointments" class="quick-action glass-card shadow-sm border-0"><div class="qa-icon" style="background:rgba(6,182,212,0.08);color:#0891b2"><i class="fas fa-calendar-day"></i></div><div><div class="fw-600">Lịch hẹn hôm nay</div><small class="text-muted">Xem và cập nhật trạng thái</small></div></a></div>
            <div class="col-md-4 col-sm-6"><a asp-action="CreateAppointment" class="quick-action glass-card shadow-sm border-0"><div class="qa-icon" style="background:rgba(16,185,129,0.08);color:#10b981"><i class="fas fa-calendar-plus"></i></div><div><div class="fw-600">Tạo lịch hẹn</div><small class="text-muted">Tạo lịch cho bệnh nhân</small></div></a></div>
            <div class="col-md-4 col-sm-6"><a asp-action="Statistics" class="quick-action glass-card shadow-sm border-0"><div class="qa-icon" style="background:rgba(244,63,94,0.08);color:#e11d48"><i class="fas fa-chart-bar"></i></div><div><div class="fw-600">Thống kê</div><small class="text-muted">Báo cáo & thống kê</small></div></a></div>
        </div>
    </div>
</div>

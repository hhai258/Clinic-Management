@{
    ViewData["Title"] = "Tạo lịch hẹn mới";
}

<div class="page-header">
    <h2>
        <div class="icon" style="background:#dbeafe;color:#1d4ed8"><i class="fas fa-calendar-plus"></i></div>
        Tạo Lịch Hẹn Mới
    </h2>
    <a asp-action="Appointments" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i>Quay lại
    </a>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card" style="max-width:780px">
    <div class="card-header">
        <i class="fas fa-calendar-plus text-primary me-2"></i>Thông tin lịch hẹn
    </div>
    <div class="card-body p-4">
        <form asp-action="CreateAppointment" method="post" id="appointmentForm">
            @Html.AntiForgeryToken()

            <!-- Bệnh nhân -->
            <div class="mb-3">
                <label class="form-label fw-semibold">Bệnh nhân <span class="text-danger">*</span></label>
                <select name="patientId" class="form-select" required id="patientSelect">
                    <option value="">-- Chọn bệnh nhân --</option>
                    @foreach (var p in ViewBag.Patients)
                    {
                        <option value="@p.UserId">@p.FullName — @p.PhoneNumber</option>
                    }
                </select>
                <small class="text-muted">Chưa có bệnh nhân? <a asp-action="CreatePatient" target="_blank">Thêm mới</a></small>
            </div>

            <!-- Bác sĩ -->
            <div class="mb-3">
                <label class="form-label fw-semibold">Bác sĩ <span class="text-danger">*</span></label>
                <select name="doctorId" class="form-select" required id="doctorSelect">
                    <option value="">-- Chọn bác sĩ --</option>
                    @foreach (var d in ViewBag.Doctors)
                    {
                        <option value="@d.DoctorId">@d.User.FullName — @d.Specialty.SpecialtyName</option>
                    }
                </select>
            </div>

            <!-- Thông tin bác sĩ được chọn -->
            <div id="doctorInfoCard" class="alert alert-info d-flex align-items-center gap-3 mb-3 py-2" style="display:none!important">
                <i class="fas fa-user-md fa-2x text-primary"></i>
                <div id="doctorInfoText"></div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">Ngày hẹn <span class="text-danger">*</span></label>
                    <input type="date" name="appointmentDate" class="form-control" required id="dateInput"
                           min="@DateTime.Today.ToString("yyyy-MM-dd")"
                           value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">Giờ hẹn <span class="text-danger">*</span></label>
                    <div id="timeSlotArea">
                        <div class="text-muted small py-2"><i class="fas fa-info-circle me-1"></i>Chọn bác sĩ và ngày để xem giờ trống</div>
                    </div>
                    <input type="hidden" name="appointmentTime" id="timeValue" />
                    <div id="timeError" class="text-danger small" style="display:none">Vui lòng chọn giờ hẹn</div>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">Lý do khám <span class="text-danger">*</span></label>
                <textarea name="reason" class="form-control" rows="3" required
                          placeholder="Nhập lý do khám bệnh, triệu chứng..."></textarea>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary" id="submitBtn">
                    <i class="fas fa-save me-1"></i>Tạo lịch hẹn
                </button>
                <a asp-action="Appointments" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

<style>
.time-slot-grid { display:flex; flex-wrap:wrap; gap:8px; }
.ts-btn {
    padding:6px 14px; border:2px solid #dbeafe; border-radius:8px;
    background:#fff; cursor:pointer; font-size:.875rem; font-weight:500;
    transition:all .15s; color:#1d4ed8;
}
.ts-btn:hover { background:#dbeafe; }
.ts-btn.selected { background:#1d4ed8; color:#fff; border-color:#1d4ed8; }
.ts-btn.booked { background:#f3f4f6; color:#9ca3af; border-color:#e5e7eb; cursor:not-allowed; text-decoration:line-through; }
</style>

@section Scripts {
<script>
var allSlots = ['08:00','09:00','10:00','11:00','13:00','14:00','15:00','16:00','17:00'];

function getDoctorId() { return document.getElementById('doctorSelect').value; }
function getDate() { return document.getElementById('dateInput').value; }

function loadTimeSlots() {
    var did = getDoctorId(), date = getDate();
    var area = document.getElementById('timeSlotArea');
    document.getElementById('timeValue').value = '';
    if (!did || !date) {
        area.innerHTML = '<div class="text-muted small py-2"><i class="fas fa-info-circle me-1"></i>Chọn bác sĩ và ngày để xem giờ trống</div>';
        return;
    }
    area.innerHTML = '<div class="text-muted small py-2"><i class="fas fa-spinner fa-spin me-1"></i>Đang tải...</div>';
    fetch('/Admin/GetAvailableTimeSlots?doctorId=' + did + '&date=' + date)
        .then(r => r.json()).then(function(available) {
            var html = '<div class="time-slot-grid">';
            allSlots.forEach(function(s) {
                var avail = available.indexOf(s) >= 0;
                html += '<div class="ts-btn' + (avail ? '' : ' booked') + '"'
                    + (avail ? ' onclick="selectSlot(this,\'' + s + '\')"' : ' title="Đã có lịch"')
                    + '>' + s + '</div>';
            });
            html += '</div><small class="text-muted mt-1 d-block"><span class="badge bg-primary me-1">Màu xanh</span>= còn trống &nbsp; <span class="badge bg-secondary">Gạch ngang</span>= đã đặt</small>';
            area.innerHTML = html;
        }).catch(function() {
            area.innerHTML = '<div class="text-danger small">Lỗi tải dữ liệu</div>';
        });
}

function selectSlot(el, val) {
    document.querySelectorAll('.ts-btn.selected').forEach(function(b){ b.classList.remove('selected'); });
    el.classList.add('selected');
    document.getElementById('timeValue').value = val;
    document.getElementById('timeError').style.display = 'none';
}

document.getElementById('doctorSelect').addEventListener('change', function() {
    var opt = this.options[this.selectedIndex];
    var info = document.getElementById('doctorInfoCard');
    if (this.value) {
        document.getElementById('doctorInfoText').textContent = opt.text;
        info.style.display = 'flex';
    } else {
        info.style.display = 'none';
    }
    loadTimeSlots();
});

document.getElementById('dateInput').addEventListener('change', loadTimeSlots);

document.getElementById('appointmentForm').addEventListener('submit', function(e) {
    if (!document.getElementById('timeValue').value) {
        e.preventDefault();
        document.getElementById('timeError').style.display = 'block';
        document.getElementById('timeSlotArea').scrollIntoView({ behavior:'smooth' });
    }
});
</script>
}

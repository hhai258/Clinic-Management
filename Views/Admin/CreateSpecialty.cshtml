@model Specialty
@{
    ViewData["Title"] = "Thêm Chuyên khoa";
}

<div class="page-header">
    <h2>
        <div class="icon" style="background:#d1fae5;color:#065f46"><i class="fas fa-plus-circle"></i></div>
        Thêm Chuyên khoa Mới
    </h2>
    <a asp-action="Specialties" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i>Quay lại
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">
                <i class="fas fa-stethoscope text-primary me-2"></i>Thông tin chuyên khoa
            </div>
            <div class="card-body p-4">
                <form asp-action="CreateSpecialty" method="post">
                    @Html.AntiForgeryToken()
                    
                    <div class="mb-3">
                        <label asp-for="SpecialtyName" class="form-label">Tên chuyên khoa *</label>
                        <input asp-for="SpecialtyName" class="form-control" placeholder="Ví dụ: Nội khoa, Nhi khoa..." required />
                        <span asp-validation-for="SpecialtyName" class="text-danger small"></span>
                    </div>
                    
                    <div class="mb-4">
                        <label asp-for="Description" class="form-label">Mô tả</label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Mô tả tóm tắt về chuyên khoa..." required></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                    
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i>Thêm chuyên khoa
                        </button>
                        <a asp-action="Specialties" class="btn btn-outline-secondary">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

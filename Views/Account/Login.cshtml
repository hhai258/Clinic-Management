@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="row justify-content-center my-5">
    <div class="col-md-6 col-lg-4">
        <div class="card glass-card shadow-lg border-0" style="border-radius: var(--radius-lg);">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <div class="brand-icon mx-auto mb-3" style="width: 48px; height: 48px; background: linear-gradient(135deg, var(--accent), var(--primary)); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; color: #fff; box-shadow: 0 4px 15px rgba(37,99,235,0.2);">
                        <i class="fas fa-hospital-alt"></i>
                    </div>
                    <h3 class="fw-800 text-dark mb-1">Đăng Nhập</h3>
                    <p class="text-muted text-sm">Hệ thống quản lý phòng khám y khoa</p>
                </div>
                
                <form asp-action="Login" method="post">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="All" class="alert alert-danger mb-3 py-2 text-sm"></div>
                    }
                    
                    <div class="mb-3">
                        <label asp-for="Username" class="form-label">Tên đăng nhập</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted" style="border-radius: 10px 0 0 10px;"><i class="fas fa-user"></i></span>
                            <input asp-for="Username" class="form-control border-start-0" placeholder="Nhập tên đăng nhập" required style="border-radius: 0 10px 10px 0;" />
                        </div>
                        <span asp-validation-for="Username" class="text-danger text-sm"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Mật khẩu</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted" style="border-radius: 10px 0 0 10px;"><i class="fas fa-lock"></i></span>
                            <input asp-for="Password" class="form-control border-start-0" type="password" placeholder="Nhập mật khẩu" required style="border-radius: 0 10px 10px 0;" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger text-sm"></span>
                    </div>
                    
                    <div class="mb-4 form-check d-flex align-items-center gap-2">
                        <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
                        <label asp-for="RememberMe" class="form-check-label text-sm text-muted">Ghi nhớ đăng nhập</label>
                    </div>
                    
                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-primary btn-lg w-100"><i class="fas fa-sign-in-alt me-1"></i>Đăng nhập</button>
                    </div>
                </form>
                
                <div class="text-center">
                    <p class="text-sm text-muted">Chưa có tài khoản? <a asp-action="Register" class="text-primary fw-600 text-decoration-none">Đăng ký ngay</a></p>
                </div>
            </div>
        </div>
        
        <div class="card mt-3 border-0 shadow-sm" style="border-radius: var(--radius); background: rgba(255,255,255,0.7);">
            <div class="card-body p-3">
                <h6 class="fw-700 text-dark mb-2"><i class="fas fa-info-circle text-info me-1"></i>Tài khoản demo:</h6>
                <div class="text-sm text-muted" style="line-height: 1.6">
                    <span class="badge bg-primary-light text-primary mb-1">Admin:</span> admin / admin123<br/>
                    <span class="badge bg-primary-light text-primary mb-1">Bác sĩ:</span> bacsi01-10 / 123456<br/>
                    <span class="badge bg-primary-light text-primary mb-1">Bệnh nhân:</span> patient01-50 / 123456
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

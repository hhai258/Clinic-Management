@model ClinicManagement.Models.ViewModels.UpdateProfileViewModel
@{ViewData["Title"] = "Cập nhật hồ sơ";}
<div class="page-header">
    <h2><i class="fas fa-user-edit me-2 text-primary"></i>Cập nhật hồ sơ cá nhân</h2>
</div>
<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header"><i class="fas fa-user me-2"></i>Thông tin cá nhân</div>
            <div class="card-body">
                <form asp-action="Profile" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label">Họ và tên *</label>
                            <input asp-for="FullName" class="form-control" required />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="DateOfBirth" class="form-label">Ngày sinh *</label>
                            <input asp-for="DateOfBirth" type="date" class="form-control" required />
                            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Gender" class="form-label">Giới tính *</label>
                            <select asp-for="Gender" class="form-select">
                                <option value="Nam">Nam</option>
                                <option value="Nữ">Nữ</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label">Số điện thoại *</label>
                            <input asp-for="PhoneNumber" class="form-control" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">Email *</label>
                            <input asp-for="Email" type="email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Address" class="form-label">Địa chỉ</label>
                            <input asp-for="Address" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EmergencyContact" class="form-label">Liên hệ khẩn cấp</label>
                            <input asp-for="EmergencyContact" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="NewPassword" class="form-label">Đổi mật khẩu (để trống nếu không đổi)</label>
                            <input asp-for="NewPassword" type="password" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label asp-for="MedicalHistory" class="form-label">Tiền sử bệnh</label>
                            <textarea asp-for="MedicalHistory" class="form-control" rows="3"
                                      placeholder="Dị ứng, bệnh mãn tính..."></textarea>
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i>Lưu thay đổi
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {<partial name="_ValidationScriptsPartial" />}

@model IEnumerable<ClinicManagement.Models.MedicalRecord>
@{ViewData["Title"] = "Lịch sử khám bệnh";}
<div class="page-header">
    <h2><i class="fas fa-file-medical me-2 text-success"></i>Lịch sử khám bệnh</h2>
</div>
@if (!Model.Any())
{<div class="text-center py-5 text-muted glass-card rounded" style="border-radius: var(--radius)"><i class="fas fa-file-medical fa-3x mb-3 d-block opacity-25"></i><p>Chưa có lịch sử khám bệnh nào</p><a asp-action="Doctors" class="btn btn-primary">Đặt lịch khám ngay</a></div>}
else
{
    <div class="row g-3">
        @foreach (var r in Model)
        {
            <div class="col-md-6">
                <div class="medical-record-card glass-card border-0 shadow-sm">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <div class="fw-700">@r.Appointment.Doctor.Degree. @r.Appointment.Doctor.User.FullName</div>
                            <span class="badge" style="background:#dbeafe;color:#2563eb">@r.Appointment.Doctor.Specialty.SpecialtyName</span>
                        </div>
                        <div class="text-end">
                            <div class="fw-600 text-muted">@r.ExaminationDate.ToString("dd/MM/yyyy")</div>
                            <span class="badge bg-success">Đã khám</span>
                        </div>
                    </div>
                    <div class="text-sm text-muted mb-1"><strong>Chẩn đoán:</strong> @(r.Diagnosis.Length > 80 ? r.Diagnosis.Substring(0,80)+"..." : r.Diagnosis)</div>
                    <a asp-action="MedicalRecordDetail" asp-route-id="@r.RecordId" class="btn btn-outline-primary btn-sm mt-2">
                        <i class="fas fa-eye me-1"></i>Xem chi tiết
                    </a>
                </div>
            </div>
        }
    </div>
}

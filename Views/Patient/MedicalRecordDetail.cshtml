@model ClinicManagement.Models.MedicalRecord
@{ViewData["Title"] = "Chi tiết bệnh án #" + Model.RecordId;}
<div class="page-header">
    <h2><i class="fas fa-file-medical-alt me-2 text-success"></i>Chi tiết bệnh án</h2>
    <a asp-action="MedicalHistory" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Quay lại</a>
</div>
<div class="row g-3">
    <div class="col-md-4">
        <div class="card">
            <div class="card-header"><i class="fas fa-user-md me-2"></i>Thông tin bác sĩ</div>
            <div class="card-body text-center">
                @if (!string.IsNullOrEmpty(Model.Appointment.Doctor.PhotoUrl))
                {<img src="@Model.Appointment.Doctor.PhotoUrl" style="width:90px;height:90px;border-radius:50%;object-fit:cover;border:3px solid #e2e8f0;margin-bottom:1rem" />}
                else
                {<div style="width:90px;height:90px;border-radius:50%;background:linear-gradient(135deg,#dbeafe,#ede9fe);display:flex;align-items:center;justify-content:center;font-size:2rem;color:#93c5fd;margin:0 auto 1rem"><i class="fas fa-user-md"></i></div>}
                <div class="fw-700">@Model.Appointment.Doctor.Degree. @Model.Appointment.Doctor.User.FullName</div>
                <div class="text-muted text-sm">@Model.Appointment.Doctor.Specialty.SpecialtyName</div>
                <div class="mt-2 text-muted text-sm"><i class="fas fa-calendar me-1"></i>Ngày khám: @Model.ExaminationDate.ToString("dd/MM/yyyy")</div>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card">
            <div class="card-header"><i class="fas fa-notes-medical me-2 text-success"></i>Kết quả khám</div>
            <div class="card-body">
                <div class="mb-4">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <div style="width:8px;height:8px;border-radius:50%;background:#3b82f6"></div>
                        <span class="fw-700 text-primary">Triệu chứng</span>
                    </div>
                    <div class="p-3 rounded" style="background:#f0f4ff;font-size:.9rem">@Model.Symptoms</div>
                </div>
                <div class="mb-4">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <div style="width:8px;height:8px;border-radius:50%;background:#f59e0b"></div>
                        <span class="fw-700 text-warning">Chẩn đoán</span>
                    </div>
                    <div class="p-3 rounded" style="background:#fef3c7;font-size:.9rem;font-weight:500">@Model.Diagnosis</div>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <div style="width:8px;height:8px;border-radius:50%;background:#10b981"></div>
                        <span class="fw-700 text-success">Lời dặn & Đơn thuốc</span>
                    </div>
                    <div class="p-3 rounded" style="background:#d1fae5;font-size:.9rem">@Model.Advice</div>
                </div>
            </div>
        </div>
    </div>
</div>

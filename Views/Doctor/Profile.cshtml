@model ClinicManagement.Models.Doctor
@{ViewData["Title"] = "Hồ sơ cá nhân";}
<div class="page-header">
    <h2><i class="fas fa-user-circle me-2 text-primary"></i>Hồ sơ cá nhân</h2>
</div>
<div class="profile-header">
    <div class="d-flex align-items-center gap-4 flex-wrap">
        @if (!string.IsNullOrEmpty(Model.PhotoUrl))
        {
            <img src="@Model.PhotoUrl" class="profile-avatar" alt="" />
        }
        else
        {
            <div class="profile-avatar-placeholder"><i class="fas fa-user-md"></i></div>
        }
        <div>
            <div class="fw-700 fs-5">@Model.Degree. @Model.User.FullName</div>
            <div class="opacity-75">@Model.Specialty.SpecialtyName · @Model.Experience năm kinh nghiệm</div>
            <div class="opacity-60 text-sm mt-1">@Model.User.Email · @Model.User.PhoneNumber</div>
        </div>
    </div>
</div>
<div class="row g-3">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header"><i class="fas fa-edit me-2"></i>Cập nhật thông tin</div>
            <div class="card-body">
                <form asp-action="UpdateProfile" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Họ và tên *</label>
                            <input type="text" name="fullName" value="@Model.User.FullName" class="form-control" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Ngày sinh</label>
                            <input type="date" name="dateOfBirth" value="@Model.User.DateOfBirth.ToString("yyyy-MM-dd")" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Giới tính</label>
                            <select name="gender" class="form-select">
                                @if (Model.User.Gender == "Nam")
                                {
                                    <option value="Nam" selected="selected">Nam</option>
                                    <option value="Nữ">Nữ</option>
                                }
                                else
                                {
                                    <option value="Nam">Nam</option>
                                    <option value="Nữ" selected="selected">Nữ</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Số điện thoại</label>
                            <input type="text" name="phoneNumber" value="@Model.User.PhoneNumber" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            <input type="email" name="email" value="@Model.User.Email" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Giới thiệu</label>
                            <textarea name="bio" class="form-control" rows="3">@Model.Bio</textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Mật khẩu mới (để trống nếu không đổi)</label>
                            <input type="password" name="newPassword" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Ảnh đại diện mới</label>
                            <input type="file" name="photo" class="form-control" accept="image/*"
                                   onchange="previewPhoto(this)" />
                        </div>
                    </div>
                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i>Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card mb-3">
            <div class="card-header"><i class="fas fa-camera me-2"></i>Ảnh đại diện</div>
            <div class="card-body text-center">
                @if (!string.IsNullOrEmpty(Model.PhotoUrl))
                {
                    <img id="photoPreview" src="@Model.PhotoUrl"
                         style="width:150px;height:150px;border-radius:50%;object-fit:cover;border:4px solid #e2e8f0" alt="" />
                }
                else
                {
                    <div id="photoPreview" style="width:150px;height:150px;border-radius:50%;background:linear-gradient(135deg,#dbeafe,#ede9fe);display:flex;align-items:center;justify-content:center;font-size:3rem;color:#93c5fd;margin:0 auto">
                        <i class="fas fa-user-md"></i>
                    </div>
                }
            </div>
        </div>
        <div class="card">
            <div class="card-header"><i class="fas fa-info-circle me-2"></i>Thông tin chuyên môn</div>
            <div class="card-body">
                <div class="row g-2 text-sm">
                    <div class="col-6"><div class="text-muted">Chuyên khoa</div><div class="fw-600">@Model.Specialty.SpecialtyName</div></div>
                    <div class="col-6"><div class="text-muted">Học vị</div><div class="fw-600">@Model.Degree</div></div>
                    <div class="col-6"><div class="text-muted">Kinh nghiệm</div><div class="fw-600">@Model.Experience năm</div></div>
                    <div class="col-6"><div class="text-muted">Giá khám</div><div class="fw-600">@Model.ExaminationFee.ToString("N0")₫</div></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function previewPhoto(input) {
    if (input.files && input.files[0]) {
        var r = new FileReader();
        r.onload = function(e) {
            var p = document.getElementById('photoPreview');
            if (p.tagName === 'IMG') {
                p.src = e.target.result;
            } else {
                var img = document.createElement('img');
                img.id = 'photoPreview';
                img.src = e.target.result;
                img.style.cssText = 'width:150px;height:150px;border-radius:50%;object-fit:cover;border:4px solid #e2e8f0';
                p.parentNode.replaceChild(img, p);
            }
        };
        r.readAsDataURL(input.files[0]);
    }
}
</script>
}

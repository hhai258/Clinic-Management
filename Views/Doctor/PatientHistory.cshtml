@model IEnumerable<ClinicManagement.Models.MedicalRecord>
@{ViewData["Title"] = "Tiền sử khám bệnh";}
<div class="page-header">
    <h2><i class="fas fa-history me-2 text-info"></i>Tiền sử khám bệnh</h2>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Quay lại</a>
</div>
@if (ViewBag.Patient != null)
{
    var pt = ViewBag.Patient as ClinicManagement.Models.User;
    <div class="card mb-4 p-3" style="background:linear-gradient(135deg,#f0f4ff,#e0e7ff)">
        <div class="d-flex align-items-center gap-3">
            <div style="width:56px;height:56px;border-radius:50%;background:linear-gradient(135deg,#dbeafe,#ede9fe);display:flex;align-items:center;justify-content:center;color:#93c5fd;font-size:1.4rem"><i class="fas fa-user"></i></div>
            <div>
                <div class="fw-700 fs-6">@pt!.FullName</div>
                <div class="text-muted text-sm">@pt.PhoneNumber · @pt.Gender · @(DateTime.Today.Year - pt.DateOfBirth.Year) tuổi</div>
                @if (!string.IsNullOrEmpty(pt.MedicalHistory))
                {<div class="badge bg-warning text-dark mt-1">Tiền sử: @pt.MedicalHistory</div>}
            </div>
        </div>
    </div>
}
@if (!Model.Any())
{<div class="text-center py-5 text-muted"><i class="fas fa-file-medical fa-3x mb-3 d-block opacity-25"></i>Chưa có lịch sử khám bệnh</div>}
else
{
    @foreach (var r in Model)
    {
        <div class="medical-record-card mb-3">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div class="fw-600">@r.ExaminationDate.ToString("dd/MM/yyyy")</div>
                <span class="badge bg-success">Đã khám</span>
            </div>
            <div class="row g-3 text-sm">
                <div class="col-md-4"><div class="text-muted mb-1">Triệu chứng</div><div>@r.Symptoms</div></div>
                <div class="col-md-4"><div class="text-muted mb-1">Chẩn đoán</div><div class="fw-600">@r.Diagnosis</div></div>
                <div class="col-md-4"><div class="text-muted mb-1">Lời dặn</div><div>@r.Advice</div></div>
            </div>
        </div>
    }
}

@model ClinicManagement.Models.ViewModels.CreatePatientViewModel
@{
    ViewData["Title"] = "Thêm bệnh nhân mới";
}

<div class="page-header">
    <h2>
        <div class="icon" style="background:#d1fae5;color:#065f46"><i class="fas fa-user-plus"></i></div>
        Thêm Bệnh nhân Mới
    </h2>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i>Quay lại
    </a>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card" style="max-width:860px">
    <div class="card-header">
        <i class="fas fa-id-card text-primary me-2"></i>Thông tin bệnh nhân
    </div>
    <div class="card-body p-4">
        <form asp-action="CreatePatient" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="alert alert-danger mb-3" id="vs" style="display:none"></div>

            <!-- Đăng nhập -->
            <div class="fw-semibold text-primary mb-2"><i class="fas fa-lock me-2"></i>Thông tin đăng nhập</div>
            <hr class="mt-0 mb-3"/>
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Username" class="form-label fw-semibold">Tên đăng nhập <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-user"></i></span>
                        <input asp-for="Username" class="form-control" placeholder="VD: nguyenvana" autocomplete="off"/>
                    </div>
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Password" class="form-label fw-semibold">Mật khẩu <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-lock"></i></span>
                        <input asp-for="Password" class="form-control" type="password" placeholder="Tối thiểu 6 ký tự" id="pwdInput"/>
                        <button class="btn btn-outline-secondary" type="button" onclick="togglePwd()"><i class="fas fa-eye" id="eyeIcon"></i></button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                    <div id="pwdStrength" class="mt-1" style="display:none">
                        <div class="progress" style="height:4px"><div class="progress-bar" id="strengthBar"></div></div>
                        <small id="strengthText" class="text-muted"></small>
                    </div>
                </div>
            </div>

            <!-- Cá nhân -->
            <div class="fw-semibold text-primary mb-2 mt-2"><i class="fas fa-user-circle me-2"></i>Thông tin cá nhân</div>
            <hr class="mt-0 mb-3"/>
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                    <input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A"/>
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="DateOfBirth" class="form-label fw-semibold">Ngày sinh <span class="text-danger">*</span></label>
                    <input asp-for="DateOfBirth" class="form-control" type="date" id="dobInput"/>
                    <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                    <small id="ageDisplay" class="text-muted"></small>
                </div>
                <div class="col-md-3">
                    <label asp-for="Gender" class="form-label fw-semibold">Giới tính <span class="text-danger">*</span></label>
                    <select asp-for="Gender" class="form-select">
                        <option value="">-- Chọn --</option>
                        <option value="Nam">Nam</option>
                        <option value="Nữ">Nữ</option>
                    </select>
                    <span asp-validation-for="Gender" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label fw-semibold">Số điện thoại <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-phone"></i></span>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="0XXXXXXXXX" maxlength="10" id="phoneInput"/>
                    </div>
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label fw-semibold">Email <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                        <input asp-for="Email" class="form-control" type="email" placeholder="example@email.com"/>
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
            </div>

            <!-- Bổ sung -->
            <div class="fw-semibold text-primary mb-2 mt-2"><i class="fas fa-info-circle me-2"></i>Thông tin bổ sung</div>
            <hr class="mt-0 mb-3"/>
            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="Address" class="form-label fw-semibold">Địa chỉ</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-map-marker-alt"></i></span>
                        <input asp-for="Address" class="form-control" placeholder="Số nhà, đường, quận/huyện, tỉnh/thành phố"/>
                    </div>
                </div>
                <div class="col-md-4">
                    <label asp-for="EmergencyContact" class="form-label fw-semibold">Liên hệ khẩn cấp</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-phone-square"></i></span>
                        <input asp-for="EmergencyContact" class="form-control" placeholder="Tên - Số điện thoại"/>
                    </div>
                </div>
                <div class="col-12">
                    <label asp-for="MedicalHistory" class="form-label fw-semibold">Tiền sử bệnh</label>
                    <textarea asp-for="MedicalHistory" class="form-control" rows="3" placeholder="Dị ứng thuốc, bệnh mãn tính, phẫu thuật trước đây..."></textarea>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-1"></i>Lưu & Đặt lịch hẹn
                </button>
                <button type="reset" class="btn btn-outline-warning">
                    <i class="fas fa-undo me-1"></i>Làm lại
                </button>
                <a asp-action="BookAppointment" class="btn btn-outline-info">
                    <i class="fas fa-calendar-plus me-1"></i>Đặt lịch bệnh nhân có sẵn
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
function togglePwd() {
    var i = document.getElementById('pwdInput'), ico = document.getElementById('eyeIcon');
    i.type = i.type === 'password' ? 'text' : 'password';
    ico.classList.toggle('fa-eye'); ico.classList.toggle('fa-eye-slash');
}
document.getElementById('pwdInput').addEventListener('input', function() {
    var v = this.value, el = document.getElementById('pwdStrength');
    if (!v) { el.style.display='none'; return; }
    el.style.display='block';
    var s = [v.length>=6, v.length>=10, /[A-Z]/.test(v), /[0-9]/.test(v), /[^A-Za-z0-9]/.test(v)].filter(Boolean).length;
    var lvls=[{w:'20%',c:'bg-danger',t:'Rất yếu'},{w:'40%',c:'bg-warning',t:'Yếu'},{w:'60%',c:'bg-info',t:'Trung bình'},{w:'80%',c:'bg-primary',t:'Mạnh'},{w:'100%',c:'bg-success',t:'Rất mạnh'}];
    var l=lvls[Math.min(s-1,4)]||lvls[0];
    var b=document.getElementById('strengthBar'); b.style.width=l.w; b.className='progress-bar '+l.c;
    document.getElementById('strengthText').textContent=l.t;
});
document.getElementById('dobInput').addEventListener('change', function() {
    if (!this.value) { document.getElementById('ageDisplay').textContent=''; return; }
    var d=new Date(this.value), t=new Date();
    var age=t.getFullYear()-d.getFullYear();
    if(t.getMonth()-d.getMonth()<0||(t.getMonth()===d.getMonth()&&t.getDate()<d.getDate()))age--;
    document.getElementById('ageDisplay').textContent=age>=0?age+' tuổi':'';
});
document.getElementById('phoneInput').addEventListener('input',function(){this.value=this.value.replace(/\D/g,'').slice(0,10);});
var vs=document.getElementById('vs'); if(vs&&vs.querySelectorAll('li').length>0)vs.style.display='block';
</script>
}

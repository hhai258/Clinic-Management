@model ClinicManagement.Models.ViewModels.ExaminationViewModel
@{ViewData["Title"] = "Khám bệnh";}
<div class="page-header">
    <h2><i class="fas fa-stethoscope me-2 text-primary"></i>Khám bệnh</h2>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Quay lại</a>
</div>
<div class="row g-3">
    <div class="col-lg-5">
        <div class="card glass-card h-100 border-0 shadow-sm">
            <div class="card-header"><i class="fas fa-user me-2 text-info"></i>Thông tin bệnh nhân</div>
            <div class="card-body">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="profile-avatar-placeholder" style="background:var(--primary-light);color:var(--primary);border:none;width:64px;height:64px;font-size:1.5rem">
                        <i class="fas fa-user"></i>
                    </div>
                    <div>
                        <div class="fw-700 fs-6">@Model.Appointment!.Patient.FullName</div>
                        <div class="text-muted text-sm">@Model.Appointment.Patient.PhoneNumber</div>
                    </div>
                </div>
                <div class="row g-2 text-sm">
                    <div class="col-6"><div class="text-muted">Ngày sinh</div><div class="fw-600">@Model.Appointment.Patient.DateOfBirth.ToString("dd/MM/yyyy")</div></div>
                    <div class="col-6"><div class="text-muted">Giới tính</div><div class="fw-600">@Model.Appointment.Patient.Gender</div></div>
                    <div class="col-12 mt-2"><div class="text-muted">Lý do khám hôm nay</div><div class="fw-600 mt-1">@Model.Appointment.Reason</div></div>
                    @if (!string.IsNullOrEmpty(Model.Appointment.Patient.MedicalHistory))
                    {
                        <div class="col-12 mt-2">
                            <div class="text-muted">Tiền sử bệnh</div>
                            <div class="mt-1 p-2 rounded" style="background:hsla(var(--warning-hsl), 0.08);color:hsl(var(--warning-hsl));font-size:.85rem;border:1px solid hsla(var(--warning-hsl), 0.2)">@Model.Appointment.Patient.MedicalHistory</div>
                        </div>
                    }
                </div>
                <div class="mt-3">
                    <a asp-action="PatientHistory" asp-route-patientId="@Model.Appointment.PatientId" class="btn btn-outline-info btn-sm w-100">
                        <i class="fas fa-history me-1"></i>Xem tiền sử khám bệnh
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card glass-card border-0 shadow-sm">
            <div class="card-header"><i class="fas fa-notes-medical me-2 text-success"></i>Kết quả khám bệnh</div>
            <div class="card-body">
                <form asp-action="Examine" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="AppointmentId" />
                    
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="All" class="alert alert-danger mb-3 py-2 text-sm"></div>
                    }

                    <div class="mb-3">
                        <label asp-for="Symptoms" class="form-label">Triệu chứng <span class="text-danger">*</span></label>
                        <textarea asp-for="Symptoms" class="form-control" rows="3" placeholder="Mô tả các triệu chứng bệnh nhân gặp phải..." required></textarea>
                        <span asp-validation-for="Symptoms" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Diagnosis" class="form-label">Chẩn đoán <span class="text-danger">*</span></label>
                        <textarea asp-for="Diagnosis" class="form-control" rows="3" placeholder="Chẩn đoán bệnh..." required></textarea>
                        <span asp-validation-for="Diagnosis" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Advice" class="form-label">Lời dặn & Đơn thuốc <span class="text-danger">*</span></label>
                        <textarea asp-for="Advice" class="form-control" rows="4" placeholder="Đơn thuốc, hướng dẫn điều trị, lời dặn bệnh nhân..." required></textarea>
                        <span asp-validation-for="Advice" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-success w-100">
                        <i class="fas fa-save me-2"></i>Lưu kết quả khám
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {<partial name="_ValidationScriptsPartial" />}
